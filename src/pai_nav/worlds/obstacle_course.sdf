<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
 <world name="pai_course">
  <physics name="default_physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
  <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
  <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
  <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
  <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <gravity>0 0 -9.8</gravity>
  <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>
  <model name="floor"><static>true</static><link name="floor_link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
  <model name="bot"><pose>0 0 0.16 0 0 0</pose>
   <link name="body"><inertial><mass>3</mass><inertia><ixx>0.03</ixx><iyy>0.04</iyy><izz>0.05</izz></inertia></inertial>
    <collision name="body_col"><geometry><box><size>0.38 0.25 0.16</size></box></geometry></collision>
    <visual name="body_vis"><geometry><box><size>0.38 0.25 0.16</size></box></geometry><material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
    <sensor name="front_lidar" type="gpu_lidar"><pose>0.12 0 0.12 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.1</min><max>6.0</max><resolution>0.01</resolution></range></lidar><always_on>true</always_on><visualize>true</visualize></sensor>
   </link>
   <link name="left_wheel"><pose>0 0.17 -0.07 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry></visual></link>
   <link name="right_wheel"><pose>0 -0.17 -0.07 1.57079632679 0 0</pose><inertial><mass>0.2</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision><visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry></visual></link>
   <joint name="left_joint" type="revolute"><parent>body</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
   <joint name="right_joint" type="revolute"><parent>body</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis></joint>
   
<link name="caster">
  <pose>-0.14 0 -0.12 0 0 0</pose>
  <inertial>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.0001</ixx>
      <iyy>0.0001</iyy>
      <izz>0.0001</izz>
    </inertia>
  </inertial>
  <collision name="caster_collision">
    <geometry>
      <sphere><radius>0.04</radius></sphere>
    </geometry>
    <surface>
      <friction>
        <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
      </friction>
    </surface>
  </collision>
  <visual name="caster_visual">
    <geometry>
      <sphere><radius>0.04</radius></sphere>
    </geometry>
  </visual>
</link>

<joint name="caster_joint" type="fixed">
  <parent>body</parent>
  <child>caster</child>
</joint>
<plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive"><left_joint>left_joint</left_joint><right_joint>right_joint</right_joint><wheel_separation>0.34</wheel_separation><wheel_radius>0.09</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><odom_publish_frequency>20</odom_publish_frequency></plugin>
  </model>
  <model name="obstacle_1"><static>true</static><pose>1.3 0 0.36 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.34</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.72</length></cylinder></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link></model>
  <model name="obstacle_2"><static>true</static><pose>2.9 -0.25 0.36 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.34</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.34</radius><length>0.72</length></cylinder></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.8 0.2 0.1 1</diffuse></material></visual></link></model>
  <model name="goal_marker"><static>true</static><pose>4 0 0.01 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.30</radius><length>0.02</length></cylinder></geometry><material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material></visual></link></model>
 </world>
</sdf>