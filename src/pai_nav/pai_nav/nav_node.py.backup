"""ROS2 differential-drive autonomous patrol with learned obstacle-avoidance policy."""
import math
import os
from ament_index_python.packages import get_package_share_directory
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from sensor_msgs.msg import LaserScan
from .policy import KNNPolicy, teacher, ACTIONS

class AutonomousNav(Node):
    def __init__(self):
        super().__init__('pai_autonomous_nav')
        self.declare_parameter('mode','ai')  # ai or baseline
        self.declare_parameter('goal_x',4.0)
        self.declare_parameter('goal_y',0.0)
        self.mode=self.get_parameter('mode').value
        self.goal=(float(self.get_parameter('goal_x').value),float(self.get_parameter('goal_y').value))
        model_path=os.path.join(get_package_share_directory('pai_nav'),'models','knn_model.json')
        self.policy=KNNPolicy.from_file(model_path)
        self.scan=None
        self.pose=None
        self.last_odom=self.get_clock().now()
        self.last_scan=self.get_clock().now()
        self.finished=False
        self.turn_action = None
        self.turn_until = 0.0

        self.pub=self.create_publisher(Twist,'/cmd_vel',10)
        self.create_subscription(LaserScan,'/scan',self.on_scan,10)
        self.create_subscription(Odometry,'/odom',self.on_odom,10)
        self.create_timer(0.1,self.step)
        self.get_logger().info(f'PAI navigation mode={self.mode}, goal={self.goal}')

    def on_scan(self,msg):
        self.scan=msg
        self.last_scan=self.get_clock().now()

    def on_odom(self,msg):
        p=msg.pose.pose.position
        q=msg.pose.pose.orientation
        yaw=math.atan2(2*(q.w*q.z+q.x*q.y),1-2*(q.y*q.y+q.z*q.z))
        self.pose=(p.x,p.y,yaw)
        self.last_odom=self.get_clock().now()

    def sector(self,angle,width=math.radians(45)):
        """Minimum valid range around a laser bearing in radians."""
        scan=self.scan
        readings=[]
        for i,range_m in enumerate(scan.ranges):
            ray=scan.angle_min+i*scan.angle_increment
            delta=math.atan2(math.sin(ray-angle),math.cos(ray-angle))
            if abs(delta)<width/2 and math.isfinite(range_m) and scan.range_min<=range_m<=scan.range_max:
                readings.append(range_m)
        return min(readings) if readings else scan.range_max

    def stop(self):
        self.pub.publish(Twist())

    def step(self):
        if self.finished:
            self.stop()
            return
        now=self.get_clock().now()
        if self.scan is None or self.pose is None or (now-self.last_scan).nanoseconds>1_000_000_000 or (now-self.last_odom).nanoseconds>1_000_000_000:
            self.stop()  # Fail safe: no recent laser or odometry.
            return
        x,y,yaw=self.pose
        distance=math.hypot(self.goal[0]-x,self.goal[1]-y)
        if distance < 0.35:
            self.finished=True
            self.stop()
            self.get_logger().info('GOAL REACHED: navigation stopped safely')
            return
        desired=math.atan2(self.goal[1]-y,self.goal[0]-x)
        err=math.atan2(math.sin(desired-yaw),math.cos(desired-yaw))
        front=self.sector(0.0)
        left=self.sector(math.pi/3)
        right=self.sector(-math.pi/3)
        features=[min(front/2.,1.),min(left/2.,1.),min(right/2.,1.),err/math.pi]
        action=self.policy.predict(features) if self.mode=='ai' else teacher(*features)
        # Collision-protection layer is identical in both experiments.
        if front<0.42 and action==0:
            action=1 if left>=right else 2
        # Avoidance direction hysteresis
        import time
        current = time.monotonic()

        if self.turn_action is not None:
            if current < self.turn_until:
                action = self.turn_action
            else:
                self.turn_action = None

        if self.turn_action is None and action in (1, 2):
            self.turn_action = action
            self.turn_until = current + 3.0

        cmd=Twist()
        if action==0:
            cmd.linear.x=0.28
            cmd.angular.z=max(-0.28,min(0.28,err*0.35))
        elif action==1:
            cmd.linear.x=0.04 if front>0.55 else 0.0
            cmd.angular.z=0.50
        else:
            cmd.linear.x=0.04 if front>0.55 else 0.0
            cmd.angular.z=-0.50
        self.pub.publish(cmd)

def main(args=None):
    rclpy.init(args=args)
    node=AutonomousNav()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.stop()
        node.destroy_node()
        rclpy.shutdown()

if __name__=='__main__':
    main()
